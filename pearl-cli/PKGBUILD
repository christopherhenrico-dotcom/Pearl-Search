# Maintainer: Your Name <you@example.com>
# ☠  Pearl CLI — The Pirate's Media CLI  ☠
# Place this PKGBUILD in a directory and run: makepkg -si

pkgname=pearl-cli
pkgver=1.0.0
pkgrel=1
pkgdesc="☠ The Pirate's Media CLI — search, browse, and play media from any URL-based source"
arch=('any')
url="https://github.com/yourname/pearl-cli"
license=('MIT')
depends=(
    'python>=3.11'
    'python-click'
    'python-rich'
    'python-requests'
    'vlc'
    'yt-dlp'
)
optdepends=(
    'python-tomli: TOML config support on Python < 3.11'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-setuptools'
    'python-wheel'
)

# ─────────────────────────────────────────────────────────────────────────────
# If hosting on a custom mirror, replace the source line below.
# For local builds, use:  source=("$pkgname-$pkgver.tar.gz")
# and place the tarball alongside this PKGBUILD.
# ─────────────────────────────────────────────────────────────────────────────
source=("$pkgname-$pkgver.tar.gz::https://your-mirror.example.com/packages/${pkgname}-${pkgver}.tar.gz")
# For development/local builds, comment out the source line above and use:
# source=("$pkgname-$pkgver::git+https://github.com/yourname/pearl-cli.git")

# Update this SHA256 after generating the tarball:
#   sha256sum pearl-cli-1.0.0.tar.gz
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # Install shell completions (optional)
    # Bash
    install -Dm644 /dev/null \
        "$pkgdir/usr/share/bash-completion/completions/pearl"
    _PEARL_COMPLETE=bash_source pearl >> \
        "$pkgdir/usr/share/bash-completion/completions/pearl" 2>/dev/null || true

    # Zsh
    install -Dm644 /dev/null \
        "$pkgdir/usr/share/zsh/site-functions/_pearl"
    _PEARL_COMPLETE=zsh_source pearl >> \
        "$pkgdir/usr/share/zsh/site-functions/_pearl" 2>/dev/null || true

    # Fish
    install -Dm644 /dev/null \
        "$pkgdir/usr/share/fish/vendor_completions.d/pearl.fish"
    _PEARL_COMPLETE=fish_source pearl >> \
        "$pkgdir/usr/share/fish/vendor_completions.d/pearl.fish" 2>/dev/null || true

    # License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true

    # README
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md" 2>/dev/null || true
}

post_install() {
    echo ""
    echo "  ☠  Pearl is installed. Set sail, Cap'n!  ☠"
    echo ""
    echo "  Quick start:"
    echo "    pearl search \"Breaking Bad\" 1080p"
    echo "    pearl config    # add your sources"
    echo "    pearl help"
    echo ""
}

post_upgrade() {
    post_install
}
